# ==============================================================================
# Synapse AI Teacher - Backend Environment Configuration (.env)
# ==============================================================================

# 1. Google Gemini AI Engine (Optional: high-fidelity offline mode if omitted)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-pro
GEMINI_FLASH_MODEL=gemini-3.6-flash

# 2. ElevenLabs Streaming Audio (Optional: defaults to browser Web Speech API)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# 3. Simli WebRTC Video Avatar (Optional: defaults to 60fps HTML5 Canvas avatar)
SIMLI_API_KEY=your_simli_api_key_here
SIMLI_FACE_ID=cace3ef7-a4c4-425d-a8cf-a5358eb0c427

# 4. Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://127.0.0.1:3000"]
